{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar Teste",
            "type": "shell",
            "command": "g++",
            "args": [
                "-I${env:SYSTEMC_HOME}/src",
                "-I${env:SYSTEMC_HOME}/objdir/src",
                "-L${env:SYSTEMC_HOME}/objdir/src/.libs",
                "main.cpp",
                "-lsystemc",
                "-o", "teste.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}